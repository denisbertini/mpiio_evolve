Bootstrap: docker
From: rockylinux/rockylinux:9.7

%labels
    APPLICATION_NAME Plasma Physics Simulation
    AUTHOR_NAME Denis Bertini
    AUTHOR_EMAIL D.Bertini@gsi.de
    YEAR 2026

%help
    Container for Plasma Physics Simulations featuring latest MPI stack.
    + It includes latest version of openMPI compiled with:
              - latest UCX library
              - latest Lustre 2.17 (el9)  client
    + in order to use efficiently on Virgo:
            - the Infiniband interconnect Fabric.
	    - the Lustre filesystem


%environment
    # Enable gcc-toolset
    source scl_source enable gcc-toolset-14

    export OMPI_DIR=/usr/local
    export SINGULARITY_OMPI_DIR=$OMPI_DIR
    export APPTAINERENV_APPEND_PATH=$OMPI_DIR/bin
    export APPTAINERENV_APPEND_LD_LIBRARY_PATH=$OMPI_DIR/lib:$OMPI_DIR/lib64
    export PATH=$OMPI_DIR/bin:$PATH
    export LD_LIBRARY_PATH=$OMPI_DIR/lib:$LD_LIBRARY_PATH
    export PATH=/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:$LD_LIBRARY_PATH

    # openMPI specifics. DEFAULT engine = embedded ROMIO (production
    # behaviour preserved), but host/harness may override: mpiio_evolve's
    # ompio candidates export OMPI_MCA_io=ompio in the job env, and an
    # unconditional export here would silently retarget every "ompio"
    # measurement back to romio341. Default-expansion makes the pin a
    # fallback instead of a cage. (OMPIO ships in this build: the
    # configure line disables no io component.)
    export OMPI_MCA_io="${OMPI_MCA_io:-romio341}"

    # epoch + openpmd-api
    export PY_API=3.12	
    export PYTHONPATH=/root/.local/lib/python$PY_API/site-packages/
    export PYTHONPATH=/usr/local/lib/python$PY_API/site-packages/:$PYTHONPATH
    export PYTHONPATH=/usr/local/lib64/python$PY_API/site-packages/:$PYTHONPATH    
    export PYTHONPATH=/opt/opmd/openPMD-api/build/lib64/python$PY_API/site-packages:$PYTHONPATH
    export PYTHONPATH=/opt/epoch/python$PY_API:$PYTHONPATH
    export PYTHONPATH=/opt/epoch/python$PY_API/sdf-1.0-py$PY_API-linux-x86_64.egg/:$PYTHONPATH   
    
%post
   #
   # Base upstream software
   #
    
   ## Packages needed but lustre-client
    dnf install -y epel-release  
    dnf install -y dkms    
    dnf -y update
    
   ## Base rlx9 
    dnf install -y dnf-plugins-core
    dnf config-manager --set-enabled crb
    dnf groupinstall -y 'Development Tools'

    dnf install -y wget git bash hostname gcc gcc-gfortran gcc-c++ libatomic make file autoconf-latest automake libtool zlib-devel python3-devel
    dnf install -y libmnl lsof numactl-libs ethtool tcl tk sqlite-devel
    dnf install -y sysstat
    
   ## Add-ons for python's packages
    dnf install -y openssl-devel bzip2-devel libffi-devel
    dnf install -y alternatives

    ## Install packages required by Slurm
    dnf install -y munge munge-devel munge-libs	
    dnf install -y mariadb-server mariadb-devel
    dnf install -y pam-devel perl readline-devel perl-Switch
    dnf install -y bash-completion 

   ## Packages required for OpenMPI and PMIx
    dnf install -y libnl3 libnl3-devel
    dnf install -y libevent libevent-devel
    dnf install -y rdma-core-devel
    dnf install -y hwloc-devel
    dnf install -y libibverbs-devel    


   ## Packages add-on for WarpX
   dnf install -y boost-devel   

   ## Add-ons for python's packages
    dnf install -y openssl-devel bzip2-devel libffi-devel
    dnf install -y alternatives

   ## Scientific libraries
   dnf install -y glibc-headers
   #dnf install -y libiconv libiconv-devel
   dnf install -y openblas openblas-devel
   dnf install -y lapack lapack-devel blas blas-devel

   #
   # (Re) Install python package
   #

    export PY_API=3.12
    export PY_VERSION=3.12.1
   # First remove all possible python versions on system 

    #dnf remove -y python36 python38 python39 python311 python312

   # Install the only relevant now 
     
    dnf install -y python$PY_API-devel
    dnf install -y python$PY_API-pip
    pip3 install --upgrade pip

   #
   # Set python default
   #
   
   alternatives --install /usr/bin/python upy2 /usr/bin/python$PY_API 99
   alternatives --install /usr/bin/python3 upy3 /usr/bin/python$PY_API 99
   alternatives --install /usr/bin/pip upy4 /usr/bin/pip3 99   
   alternatives --list

   # Check versions of basic packages
   python --version
   pip --version
    

   #
   # Install secondary python packages
   # using virtual environment
   #

   # Initiate environment
   python -m pip --no-cache-dir install virtualenv

   mkdir /venv
   virtualenv /venv/plasma
   source /venv/plasma/bin/activate

   echo '. /venv/plasma/bin/activate' >> $SINGULARITY_ENVIRONMENT

   ## Update python pip.
   python3 -m pip --no-cache-dir install --upgrade pip
   python3 -m pip --no-cache-dir install setuptools --upgrade

   ## General packages
   python3 -m pip --no-cache-dir install setuptools --upgrade
   python3 -m pip --no-cache-dir install psutil schedule 
   python3 -m pip --no-cache-dir install SQLAlchemy
   python3 -m pip --no-cache-dir install dash    
        
   ## Install Data Science packages
   python3 -m pip --no-cache-dir install ipython jupyterlab		   
   python3 -m pip --no-cache-dir install numpy pandas h5py pyarrow scikit-learn statsmodels matplotlib seaborn plotly yt
   python3 -m pip --no-cache-dir install recommonmark  kaleido
   python3 -m pip --no-cache-dir install networkx sphinx sphinx-rtd-theme  
   python3 -m pip --no-cache-dir install datashader
    
   ## Install package specific to PP 
   python3 -m pip --no-cache-dir install lmfit

   ## Dask
   ## Dask Dependencies
   python3 -m pip --no-cache-dir install bokeh graphviz cachey cityhash xxhash crick
   python3 -m pip --no-cache-dir install cytoolz lz4 mmh3 python-snappy
   python3 -m pip --no-cache-dir install sparse zarr
   python3 -m pip --no-cache-dir install fastparquet
   python3 -m pip --no-cache-dir install pyarrow
   ## Dask itself
   python3 -m pip --no-cache-dir install "dask[complete]"
   python3 -m pip --no-cache-dir install dask-jobqueue --upgrade
   python3 -m pip --no-cache-dir install dask-labextension
   python3 -m pip --no-cache-dir install dask-ml    

   ## Install modules needed by pytorch
   python3 -m pip --no-cache-dir install typing-extensions

   ## Python's packaging libraries Needed for WarpX
   python3 -m pip --no-cache-dir install build packaging setuptools wheel
   python3 -m pip --no-cache-dir install cmake 
   python3 -m pip --no-cache-dir install periodictable numba

   ## Job Monitoring
   ## Prometheus client API 
   python3 -m pip --no-cache-dir install prometheus-api-client
   python3 -m pip --no-cache-dir install Pillow plotly argparse pyranges bs4 rich 

   CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
   cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1="[pp_cpu\w \$ "
EOF
   chmod 755 $CUSTOM_ENV

   cat <<EOF >/etc/yum.repos.d/lustre-client.repo
[lustre-client]
name=Lustre Client
gpgcheck=0
baseurl=http://downloads.whamcloud.com/public/lustre/lustre-2.17.0/el9.7/client
EOF
yum install -y lustre-client lustre-client-devel

   ## Prior to compilation
   ## Install and enable gcc-toolset
   dnf install -y gcc-toolset-14
   source scl_source enable gcc-toolset-14

   # Set up the environment (for the container build process)
   #export PATH=/usr/local/cuda/bin:${PATH}
   #export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/lib:${LD_LIBRARY_PATH}
 
   #
   # PMIx 
   #

   export VPMIX_VERSION=6.0.0
   echo "Installing PMIx version: " $VPMIX_VERSION	
   mkdir -p /opt/pmix
   cd /opt/pmix
   wget -c https://github.com/openpmix/openpmix/releases/download/v$VPMIX_VERSION/pmix-$VPMIX_VERSION.tar.gz
   tar xf pmix-$VPMIX_VERSION.tar.gz
   cd pmix-$VPMIX_VERSION
   ./configure --prefix=/usr/local --with-munge=/usr && \
   make -j$(nproc)
   make -j$(nproc) install      
   #rm -rf /tmp/pmix

   export PRRTE_VERSION=4.0.0
   echo "Installing PRRTE version: " $PRRTE_VERSION	
   mkdir -p /opt/prrte
   cd /opt/prrte
   wget -c https://github.com/openpmix/prrte/releases/download/v$PRRTE_VERSION/prrte-$PRRTE_VERSION.tar.gz
   tar xf prrte-$PRRTE_VERSION.tar.gz
   cd prrte-$PRRTE_VERSION
   ./configure --prefix=/usr/local --with-pmix=/usr/local --with-slurm  && \
   make -j$(nproc)
   make -j$(nproc) install      
   #rm -rf /tmp/prrte


   #
   # UCX
   #

   export UCX_VERSION=1.22.0
   echo "Installing UCX version:  " $UCX_VERSION
   cd /
   mkdir -p /var/tmp && wget -q -nc --no-check-certificate -P /var/tmp https://github.com/openucx/ucx/releases/download/v$UCX_VERSION/ucx-$UCX_VERSION.tar.gz
   mkdir -p /var/tmp && tar -x -f /var/tmp/ucx-$UCX_VERSION.tar.gz -C /var/tmp -z
   cd /var/tmp/ucx-$UCX_VERSION &&   ./configure --prefix=/usr/local/ucx --disable-assertions --disable-debug --disable-doxygen-doc --disable-logging --disable-params-check --enable-optimizations --enable-mt --without-cuda
   make -j$(nproc)
   make -j$(nproc) install
   rm -rf /var/tmp/ucx-$UCX_VERSION /var/tmp/ucx-$UCX_VERSION.tar.gz

   #
   # OpenMPI installation
   #
 
   export OMPI_DIR=/usr/local
   export OMPI_VERSION=5.0.11
   export OMPI_URL="https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-$OMPI_VERSION.tar.bz2"
   echo "Installing OpenMPI version: " $OMPI_VERSION
   mkdir -p /root/ompi
   cd /root/ompi
   wget -c -O openmpi-$OMPI_VERSION.tar.bz2 $OMPI_URL && tar -xjf openmpi-$OMPI_VERSION.tar.bz2

   # Compile and install
   cd /root/ompi/openmpi-$OMPI_VERSION
   ./configure --prefix=$OMPI_DIR --with-pmix=/usr/local --with-prrte=/usr/local --with-libevent=/usr --with-ompi-pmix-rte --with-orte=no --disable-oshmem --enable-mpirun-prefix-by-default --enable-shared  --without-verbs --with-hwloc --with-ucx=/usr/local/ucx --with-lustre --with-slurm --enable-mca-no-build=btl-uct --disable-sphinx
   make -j$(nproc)
   make -j$(nproc) install

   # Set env variables so we can compile our applications
   export PATH=$OMPI_DIR/bin:$PATH
   export LD_LIBRARY_PATH=$OMPI_DIR/lib:$LD_LIBRARY_PATH
   export MANPATH=$OMPI_DIR/share/man:$MANPATH
   export COMPILER=gfortran
   export PYTHONPATH=/root/.local/lib/python$PY_API/site-packages:$PYTHONPATH


  # Install MPI based python modules
   export PATH=/usr/local/bin:$PATH
   export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:$LD_LIBRARY_PATH
   python3 -m pip --no-cache-dir install mpi4py
   python3 -m pip --no-cache-dir install h5py   
   python3 -m pip --no-cache-dir install dask_mpi --upgrade
    

  #
  # Cmake
  #
  
  export CMAKE_DIR=/usr/local
  export CMAKE_VERSION=4.4.3
  echo "Installing CMake version: " $CMAKE_VERSION
  mkdir -p /tmp/cmake
  cd /tmp/cmake
  curl -OL https://github.com/Kitware/CMake/releases/download/v$CMAKE_VERSION/cmake-$CMAKE_VERSION-linux-x86_64.sh
  /bin/sh /tmp/cmake/cmake-$CMAKE_VERSION-linux-x86_64.sh --prefix=/usr/local --skip-license 
  rm -rf /tmp/cmake
  PATH=/usr/local/bin:$PATH


  #
  # Install HDF5
  #
  
  export HDF5_VERSION=2.2.0
  echo "Installing HDF5 version: " $HDF5_VERSION
  cd /tmp
  rm -rf hdf5-$HDF5_VERSION/
  /usr/bin/wget -c https://github.com/HDFGroup/hdf5/releases/download/$HDF5_VERSION/hdf5-$HDF5_VERSION.tar.gz 
  tar -xf hdf5-$HDF5_VERSION.tar.gz
  cd hdf5-$HDF5_VERSION/
  mkdir build
  cd build
  cmake .. \
  -DCMAKE_INSTALL_PREFIX=/usr/local \
  -DCMAKE_BUILD_TYPE=Release \
  -DHDF5_ENABLE_PARALLEL=ON \
  -DHDF5_BUILD_FORTRAN=ON \
  -DHDF5_BUILD_CPP_LIB=OFF \
  -DHDF5_BUILD_HL_LIB=ON \
  -DBUILD_SHARED_LIBS=ON

  make -j$(nproc) 
  make -j$(nproc) install 
  rm -rf /tmp/hdf5-$HDF5_VERSION/

  #
  # ADIOS2
  #
  
  export ADIOS_VERSION=2.12.1
  echo "Installing ADIOS2 version: " $ADIOS_VERSION
  rm -rf /tmp/adios
  mkdir -p /tmp/adios
  cd /tmp/adios
  git clone https://github.com/ornladios/ADIOS2.git
  cd ADIOS2
  git checkout v$ADIOS_VERSION
  mkdir adios2-build
  cd adios2-build
  # NOTE: ADIOS2_USE_MPI must be requested EXPLICITLY. Without it the
  # build silently produces a serial-only ADIOS2 (no MPI_Comm anywhere in
  # the C++ API) which cannot merge multi-rank output -- discovered the
  # hard way via pio-bench. With MPI installed earlier in this %post,
  # ON either wires it up or fails the build loudly. Good.
  cmake ../ -DCMAKE_PREFIX_INSTALL=/usr/local/ -DADIOS2_BUILD_EXAMPLES=OFF -DADIOS2_BUILD_TESTING=OFF -DADIOS2_USE_Fortran=ON -DADIOS2_USE_HDF5=OFF -DADIOS2_USE_MPI=ON -DCMAKE_CXX_FLAGS=-fPIC
  make -j$(nproc)
  make -j$(nproc) install  
  rm -rf /tmp/adios
  PATH=/usr/local/bin:$PATH   

  #
  # openPMD-API
  #
  
  mkdir -p /opt/opmd
  cd /opt/opmd
  git clone  https://github.com/openPMD/openPMD-api.git openPMD-api
  cd /opt/opmd/openPMD-api
  git checkout 0.17.1
  mkdir -p /opt/opmd/openPMD-api/build
  cd /opt/opmd/openPMD-api/build
  cmake -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DopenPMD_USE_ADIOS2=ON -DopenPMD_USE_ADIOS1=OFF -DopenPMD_USE_PYTHON=ON /opt/opmd/openPMD-api
  cmake --build /opt/opmd/openPMD-api/build --target install -- -j$(nproc)

  # OpenPMD_Viewer 
   python3 -m pip --no-cache-dir install openpmd-viewer 


  #
  # IOR
  #
  
  rm -rf /tmp/io
  mkdir -p /tmp/io
  cd /tmp/io
  git clone https://github.com/hpc/ior.git 
  cd ior/
  git checkout 4.0.0
  ./bootstrap
  ./configure --with-lustre --with-hdf5 --prefix=/usr/local
  make -j$(nproc)
  make -j$(nproc) install
  rm -rf /tmp/io


  #
  # Darshan I/O profiler (instrumentation runtime + parser util)
  # + mpiio_evolve fitness source: pure-I/O time, aggregator topology,
  #   Lustre OST attribution (lustre + dxt modules, both default-on;
  #   dxt tracing itself is activated per-job via DXT_ENABLE_IO_TRACE=1).
  # NOTE: release tagging changed with 3.5.0 -- older tags carry the
  # 'darshan-' prefix (darshan-3.4.7), 3.5.0+ are tagged PLAIN (see
  # github releases); checkout must use the bare version.
  # 3.5.0 relevant changes: mmap logs default-ON; job_stats/file_stats gain
  # "I/O bandwidth by slowest rank" + "I/O time by slowest" (fitness v2).
  #
   export DARSHAN_VERSION=3.5.0
   echo "Installing Darshan version: " $DARSHAN_VERSION
   dnf install -y zlib-devel
   rm -rf /opt/darshan
   cd /opt
   git clone https://github.com/darshan-hpc/darshan.git
   cd /opt/darshan
   git checkout $DARSHAN_VERSION
   git submodule update --init --recursive
   ./prepare.sh
   # runtime (LD_PRELOAD instrumentation). No --enable-apmpi-mod: that
   # module requires Argonne Performance MPI headers, absent here.
   cd /opt/darshan/darshan-runtime
   ./configure --prefix=/usr/local --with-mem-align=8 \
     --with-log-path-by-env=DARSHAN_LOGPATH --with-jobid-env=SLURM_JOBID \
     --enable-hdf5-mod --with-hdf5=/usr/local \
     --enable-mmap-logs --enable-cuserid CC=mpicc
   make -j$(nproc)
   make -j$(nproc) install
   # util (log parsers: darshan-parser, darshan-dxt-parser, ...)
   cd /opt/darshan/darshan-util
   ./configure
   make -j$(nproc)
   make -j$(nproc) install
   rm -rf /opt/darshan

   # PyDarshan: python log analysis (used for metric extraction).
   python3 -m pip --no-cache-dir install darshan
   # Analysis-workbench tools (Drishti / DXT-Explorer pull Qt & plot
   # stacks): they belong on the controller/workstation, NOT the compute
   # image -- install there if interactive I/O forensics are wanted:
   #   python3 -m pip install recorder-utils drishti-io dxt-explorer

   #
  # OSU microbenchmarks
  #
 
  export OSU_VERSION=7.5.2
  echo "Installing OSU Microbenchmarks version: " $OSU_VERSION
  cd /tmp
  wget -c https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-$OSU_VERSION.tar.gz
  tar xf osu-micro-benchmarks-$OSU_VERSION.tar.gz
  cd osu-micro-benchmarks-$OSU_VERSION/
  echo "Configuring and building OSU Micro-Benchmarks..."
  ./configure --prefix=/usr/local/osu CC=/usr/local/bin/mpicc CXX=/usr/local/bin/mpicxx CFLAGS=-I$(pwd)/util
  make -j$(nproc)
  make -j$(nproc) install
  # copy back all MPI benchmarks to /usr/local
  cp -R /usr/local/osu/libexec/osu-micro-benchmarks/mpi/* /usr/local/bin
  rm -rf /tmp/osu-micro-benchmarks-$OSU_VERSION/  


  #
  # Epoch
  # + python SDF module
  #
  
  export EPOCH_VERSION=4.20.1	  
  echo " Installing EPOCH version: " $EPOCH_VERSION
  cd /usr/local/
  git clone --recursive https://github.com/Warwick-Plasma/epoch.git
  cd epoch
  git checkout v$EPOCH_VERSION
  sed -i 's/FFLAGS = -O3 -g/FFLAGS = -O3 -g -fPIC/g' SDF/FORTRAN/Makefile
  cd epoch1d
  sed -i 's/FFLAGS = -O3 -g -std=f2003/FFLAGS = -O3 -g -std=f2003 -fPIC/g' Makefile
  sed -i 's/#DEFINES += $(D)PARTICLE_ID$/DEFINES += $(D)PARTICLE_ID/g' Makefile
  make -j$(nproc)
  cp bin/epoch1d /usr/local/bin
  make sdfutils  
  cd ../epoch2d
  sed -i 's/FFLAGS = -O3 -g -std=f2003/FFLAGS = -O3 -g -std=f2003 -fPIC/g' Makefile  
  sed -i 's/#DEFINES += $(D)PARTICLE_ID$/DEFINES += $(D)PARTICLE_ID/g' Makefile  
  make -j$(nproc)
  cp bin/epoch2d /usr/local/bin
  make sdfutils  
  cd ../epoch3d
  sed -i 's/FFLAGS = -O3 -g -std=f2003/FFLAGS = -O3 -g -std=f2003 -fPIC/g' Makefile  
  sed -i 's/#DEFINES += $(D)PARTICLE_ID$/DEFINES += $(D)PARTICLE_ID/g' Makefile  
  make -j$(nproc)
  cp bin/epoch3d /usr/local/bin
  make sdfutils
  cd /usr/local/epoch
  cd epoch1d
  make clean
  sed -i 's/INTEGER, PARAMETER :: string_length = 256$/INTEGER, PARAMETER :: string_length = 100000/g' src/constants.F90
  make -j$(nproc)
  cp bin/epoch1d /usr/local/bin/epoch1d_lstr
  cd ../epoch2d
  make clean
  sed -i 's/INTEGER, PARAMETER :: string_length = 256$/INTEGER, PARAMETER :: string_length = 100000/g' src/constants.F90
  make -j$(nproc)
  cp bin/epoch2d /usr/local/bin/epoch2d_lstr
  cd ../epoch3d
  make clean
  sed -i 's/INTEGER, PARAMETER :: string_length = 256$/INTEGER, PARAMETER :: string_length = 100000/g' src/constants.F90
  make -j$(nproc)
  cp bin/epoch3d /usr/local/bin/epoch3d_lstr
  #mkdir -p /opt/epoch/python3.6/
  #cp -R /root/.local/lib/python3.6/site-packages/sdf* /opt/epoch/python3.6/

  #
  # WarpX
  # With openMPI + OpenMP + openPMD  only
  #
  export WARPX_VERSION=26.09  
  echo "INstalling WarpX version: " $WARPX_VERSION
  
  rm   -rf /tmp/warp
  mkdir -p /tmp/warp
  cd /tmp/warp
  git clone https://github.com/ECP-WarpX/WarpX.git
  cd WarpX
  git checkout $WARPX_VERSION

  # Build all dimensions 1,2,rz,3 together
  CXX=/usr/local/bin/mpicxx CC=/usr/local/bin/mpicc cmake -S . -B build -DWarpX_DIMS="1;2;RZ;3" -D AMReX_TINY_PROFILE=FALSE -D MPI_C_COMPILER=/usr/local/bin/mpicc -D MPI_CXX_COMPILER=/usr/local/bin/mpicxx -DWarpX_OPENPMD=ON -DWarpX_PYTHON=ON -DCMAKE_INSTALL_PREFIX=/usr/local/
  # Install
  cmake --build build -j 10 --target install
  rm -rf /tmp/warp

  # create aliases
  cd /usr/local/bin
  ln -s warpx.1d.MPI.OMP.DP.PDP.OPMD.QED warpx_1d
  ln -s warpx.2d.MPI.OMP.DP.PDP.OPMD.QED warpx_2d
  ln -s warpx.3d.MPI.OMP.DP.PDP.OPMD.QED warpx_3d 
  ln -s warpx.rz.MPI.OMP.DP.PDP.OPMD.QED warpx_rz

  #
  # pio-bench: purpose-built MPI-IO/HDF5/ADIOS2 checkpoint instrument
  # (fitness instrument of mpiio_evolve, https://github.com/denisbertini/pio-bench).
  # PINNED BY TAG on purpose: the fitness instrument must be frozen per
  # campaign; bump deliberately, never implicitly. Requires v0.2.1+
  # (ROMIO-info pass-through: candidate ROMIO_HINTS must not be overridden;
  # tag must exist before this build runs).
  # v0.3.0: openPMD backends (pmd_hdf5 / pmd_adios2) -- compiled in only
  # because the openPMD 0.17.1 build block earlier in this file runs
  # first; the backend-report gate below must show BOTH pmd engines.
  #
  export PIO_BENCH_VERSION=v0.3.0
  echo "Installing pio-bench version: " $PIO_BENCH_VERSION
  rm -rf /tmp/piobench
  git clone --depth 1 --branch $PIO_BENCH_VERSION https://github.com/denisbertini/pio-bench.git /tmp/piobench
  cd /tmp/piobench
  # A backend silently compiled OUT (missing lib, MPI-less ADIOS2) would
  # distort fitness invisibly -- grep the configure log and FAIL the image
  # build instead of shipping a crippled instrument.
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release | tee /tmp/piobench-configure.log
  grep -q "pio_bench: HDF5 backend ON"   /tmp/piobench-configure.log || { echo "FATAL: pio-bench built WITHOUT hdf5 backend"; exit 1; }
  grep -q "pio_bench: ADIOS2 backend ON" /tmp/piobench-configure.log || { echo "FATAL: pio-bench built WITHOUT adios2 backend (needs cxx_mpi, cf. ADIOS2_USE_MPI=ON above)"; exit 1; }
  grep -q "pio_bench: openPMD backend ON" /tmp/piobench-configure.log || { echo "FATAL: pio-bench built WITHOUT openPMD backend (pmd_* profiles would be dead; openPMD 0.17.1 block must run first)"; exit 1; }
  cmake --build build -j$(nproc)
  cmake --install build    # -> /usr/local/bin/pio_bench
  # In-image self-test gate: every backend must actually run + verify.
  # (Login-node scale; catches link/runtime breakage at BUILD time.)
  cd /tmp/piobench && MPIRUN="mpirun --allow-run-as-root" ./scripts/smoke.sh
  rm -rf /tmp/piobench



%runscript
exec /bin/bash "$@"
%startscript
exec /bin/bash "$@"

