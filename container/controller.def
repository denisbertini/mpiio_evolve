Bootstrap: docker
# Same EL9 base as plasma_pp.def (ABI parity for the Slurm/munge client
# stack built in %post).
From: rockylinux/rockylinux:9.7

%labels
    APPLICATION_NAME mpiio_evolve controller
    AUTHOR_NAME Denis Bertini
    AUTHOR_EMAIL D.Bertini@gsi.de
    YEAR 2026

%help
    Self-contained CONTROLLER image for mpiio_evolve (OpenEvolve-driven
    MPI-IO tuning).  Carries Python 3.11 + OpenEvolve (+ every package it
    imports at runtime) and a version-matched Slurm CLIENT, so the evolution
    loop runs CONFINED on a login node:

        ./tools/run_controller_sif.sh [openevolve_config.yaml]

    The container sees only: ppio_tune (rw), the repo (ro), /etc/slurm
    (ro), the munge socket (ro) and the cluster SPANK plugin (ro) -- the
    latter two bound explicitly by tools/run_controller_sif.sh, since
    apptainer.conf 'mungepath' is not active on this cluster.  $HOME and
    the rest of /lustre are invisible.  Benchmark jobs themselves run
    OUTSIDE this container (unchanged plasma_pp.sif path on compute nodes).

    Lustre: the CLIENT is a HOST-KERNEL service the container shares; a
    container only needs the userspace 'lfs' (an ioctl frontend) plus the
    Lustre mount visible.  Two independent layers, belt and suspenders:
      1. NATIVE: this image installs the WhamCloud lustre-client USERSPACE
         (2.17.0 el9, same repo/version as plasma_pp.def -- whose native
         lfs is proven against this cluster's kernel client).  No kernel
         module is installed -- useless inside a container.
      2. BIND: tools/run_controller_sif.sh also binds the host 'lfs' +
         its two non-glibc libs read-only when present (proven on
         ccdev0002: setstripe -c 4 -S 1M round-trip, lfs 2.15.8).  The
         bind target shadows the image copy, so the host-matched version
         stays the default; the native one engages exactly where the bind
         is skipped (host without lfs) instead of tripping the strict
         guard.
    With either layer, stripe_count/stripe_size ARE evolved from the
    container (workspace.lustre_strict: true).  Neither layer present ->
    evaluate.py refuses real runs under strict mode (by design) -- or set
    lustre_strict: false to tune hints only.

    BUILD: the Slurm client defaults to the cluster version 26.05.4 and
    must otherwise MATCH the cluster ('sbatch --version' on the login
    node), e.g. for another cluster:

        apptainer build --build-arg SLURM_VERSION=<x.yy.z> \
            images/controller.sif container/controller.def

    One sif per cluster (Orion ccdev and virgo4 differ); pick it with
    MPIIO_EVOLVE_CONTROLLER_SIF.

%files
    # Slurm commands dlopen the UNVERSIONED 'libslurmfull.so'; the image's
    # own copy lives inside the plugin dir /usr/lib64/slurm/, which gets
    # shadowed when the host's /usr/lib64/slurm is bound in (the host keeps
    # it versioned only).  Unversioned copies in the normal lib path make
    # sinfo/srun/sbatch work in both cases.  Same trick as plasma_pp.def,
    # adapted to slurm 26.05.4 (soname libslurm.so.45).
    # NOTE: %files copies from the BUILD NODE -- build on a login node
    # running exactly this slurm version, else apptainer fails the build.
    /lib64/libslurmfull-26.05.4.so  /lib64/libslurmfull-26.05.4.so
    /lib64/libslurmfull-26.05.4.so  /lib64/libslurmfull.so
    /lib64/libslurm.so.45.0.0       /lib64/libslurm.so.45.0.0
    /lib64/libslurm.so.45.0.0       /lib64/libslurm.so
    /lib64/libslurm_pmi-26.05.4.so  /lib64/libslurm_pmi-26.05.4.so
    /lib64/libslurm_pmi-26.05.4.so  /lib64/libslurm_pmi.so

%environment
    export PATH=/venv/controller/bin:/usr/local/bin:$PATH

%post
set -eux

## ------------------------------------------------------------ base packages
dnf install -y epel-release dnf-plugins-core
# CRB (CodeReady Builder): munge-devel lives HERE on EL9 (AppStream ships
# only the runtime munge/munge-libs; EPEL9 has no munge at all).
dnf config-manager --set-enabled crb
dnf install -y wget bzip2 tar which file gcc make
dnf install -y python3.11 python3.11-pip python3.11-devel

## Packages required by Slurm -- same set proven in the plasma image
dnf install -y munge munge-libs munge-devel
dnf install -y mariadb-server mariadb-devel
dnf install -y pam-devel perl readline-devel perl-Switch bash-completion
dnf install -y sqlite-devel hwloc-devel
dnf install -y libjwt-devel   # BuildRequires of Slurm >= 24.11 (EPEL9)

## ------------------------------------------------- Lustre client (userspace)
# 'lfs' is only an ioctl frontend to the HOST-kernel Lustre client, so the
# USERSPACE tools suffice in a container (no kernel module -- it could never
# load here).  Same repo/version as plasma_pp.def, whose native lfs is
# proven against this cluster.  This makes controller.sif self-sufficient
# for 'lfs setstripe' when run_controller_sif.sh's host-lfs bind is absent
# (the bind, when present, shadows this copy with the host-matched one).
cat <<'EOF' > /etc/yum.repos.d/lustre-client.repo
[lustre-client]
name=Lustre Client
gpgcheck=0
baseurl=http://downloads.whamcloud.com/public/lustre/lustre-2.17.0/el9.7/client
EOF
dnf install -y lustre-client
# gate: never ship a crippled controller (striping mutations would be
# silently dead if both the native lfs AND the host bind were missing)
command -v lfs >/dev/null || { echo "FATAL: lustre-client installed but no lfs on PATH"; exit 1; }
lfs version >/dev/null 2>&1 || true   # 'lfs version' needs a mount: fine at build time

## ------------------------------------------------------------------- Slurm
# Client-side build, same recipe proven in the plasma image: plain
# configure/make install from the official tarball.
# Default version is the cluster's (slurm 26.05.4); a client that does not
# match the cluster's slurmctld refuses to talk to it (protocol mismatch),
# so other clusters override at build time:
#   apptainer build --build-arg SLURM_VERSION=<x.yy.z> ...
VERSION="${SLURM_VERSION:-26.05.4}"
mkdir -p /opt/slurm-build && cd /opt/slurm-build
wget -nc https://download.schedmd.com/slurm/slurm-$VERSION.tar.bz2 \
  || wget -nc https://download.schedmd.com/slurm/archive/slurm-$VERSION.tar.bz2
tar xf slurm-$VERSION.tar.bz2
cd slurm-$VERSION
./configure --prefix=/usr --with-mysql_config=/usr/bin \
            --libdir=/usr/lib64 --sysconfdir=/etc/slurm
make -j"$(nproc)"
make install
cd / && rm -rf /opt/slurm-build

# Slurm user/group (same convention as the plasma image)
groupadd -r --gid=990 slurm
useradd -r -g slurm --uid=990 slurm

# No sbatch smoke-test here: even '--version' demands a valid cluster
# config (ClusterName, slurmctld...) which a bare build container cannot
# have.  Verify presence instead; real validation happens on the login
# node where run_controller_sif.sh binds the cluster's /etc/slurm.
test -x /usr/bin/sbatch \
    || { echo "FATAL: sbatch not installed"; exit 1; }
# Hard gate: a slurm built without munge support would install fine and
# then fail at every sbatch with an auth error.  Demand the plugin.
test -f /usr/lib64/slurm/auth_munge.so \
    || { echo "FATAL: slurm built WITHOUT auth_munge"; exit 1; }

## -------------------------------------------------- OpenEvolve (pinned venv)
# THE whole point: the FULL dependency tree installed at BUILD time, once,
# loudly -- never again on a login node.  Every package OpenEvolve imports
# at runtime is listed EXPLICITLY (pip transitive resolution alone is not a
# contract): openai = LLM client, pyyaml = config, dacite = config->dataclass,
# numpy/tqdm = engine, flask = monitoring API, cloudpickle = program serialis-
# ation (required by current openevolve releases, missing from older metadata).
python3.11 -m venv /venv/controller
/venv/controller/bin/pip install --upgrade pip setuptools wheel
/venv/controller/bin/pip install \
    "openevolve==0.4.0" \
    "openai>=1.0.0" \
    "pyyaml>=6.0" \
    "numpy>=1.22.0" \
    "tqdm>=4.64.0" \
    "flask" \
    "dacite>=1.9.2" \
    "cloudpickle>=2.0.0"
# Hard gate: import exactly what tools/launch_evolution.py + openevolve need.
# A missing dependency must fail the IMAGE BUILD, not the first tmux session.
/venv/controller/bin/python -c "
from openevolve import OpenEvolve
import openai, yaml, numpy, tqdm, flask, dacite, cloudpickle
print('openevolve + full dependency tree import OK')"

## --------------------------------------------------------------- slim down
# Register the %files-copied slurm libs (unversioned libslurmfull.so etc.)
# in the loader cache; %files content is already in place when %post runs.
ldconfig
# NEVER 'rm -rf /tmp/*' here: in %post, /tmp IS THE HOST /tmp (bound in by
# apptainer) -- wiping it deletes login-node files and Apptainer's own
# build mounts.  Build scratch (/opt/slurm-build) was removed in place.
dnf clean all
rm -rf /var/cache/dnf /root/.cache/pip

%runscript
    exec "$@"
