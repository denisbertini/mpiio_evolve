Bootstrap: docker
# Same EL9 base as plasma_pp.def (ABI parity for the Slurm/munge client
# stack built in %post).
From: rockylinux/rockylinux:9.7

%labels
    APPLICATION_NAME mpiio_evolve controller
    AUTHOR_NAME Denis Bertini
    AUTHOR_EMAIL D.Bertini@gsi.de
    YEAR 2026

%help
    Self-contained CONTROLLER image for mpiio_evolve (OpenEvolve-driven
    MPI-IO tuning).  Carries Python 3.11 + OpenEvolve (+ every package it
    imports at runtime) and a version-matched Slurm CLIENT, so the evolution
    loop runs CONFINED on a login node:

        ./tools/run_controller_sif.sh [openevolve_config.yaml]

    The container sees only: ppio_tune (rw), the repo (ro), /etc/slurm
    (ro) and the munge socket (auto-bound by apptainer.conf 'mungepath',
    same mechanism that made the old dask image submit jobs).  $HOME and
    the rest of /lustre are invisible.  Benchmark jobs themselves run
    OUTSIDE this container (unchanged plasma_pp.sif path on compute nodes).

    NO Lustre client here, on purpose: the kernel client lives on the
    host only and the userspace lfs adds nothing inside this image.
    Consequence: stripe_count/stripe_size mutations cannot be applied
    from the container.  Either run the bare-metal controller
    (tools/run_controller.sh on the login node, host lfs) when striping
    is part of the search, or set  workspace.lustre_strict: false  in
    config.yaml to deliberately tune MPI-IO hints only.  Without that,
    evaluate.py refuses real runs with a clear error (by design).

    BUILD: the Slurm client defaults to the cluster version 26.05.4 and
    must otherwise MATCH the cluster ('sbatch --version' on the login
    node), e.g. for another cluster:

        apptainer build --build-arg SLURM_VERSION=<x.yy.z> \
            images/controller.sif container/controller.def

    One sif per cluster (Orion ccdev and virgo4 differ); pick it with
    MPIIO_EVOLVE_CONTROLLER_SIF.

%environment
    export PATH=/venv/controller/bin:/usr/local/bin:$PATH

%post
set -eux

## ------------------------------------------------------------ base packages
dnf install -y epel-release dnf-plugins-core
# CRB (CodeReady Builder): munge-devel lives HERE on EL9 (AppStream ships
# only the runtime munge/munge-libs; EPEL9 has no munge at all).
dnf config-manager --set-enabled crb
dnf install -y wget bzip2 tar which file gcc make
dnf install -y python3.11 python3.11-pip python3.11-devel

## Packages required by Slurm -- same set proven in the plasma image
dnf install -y munge munge-libs munge-devel
dnf install -y mariadb-server mariadb-devel
dnf install -y pam-devel perl readline-devel perl-Switch bash-completion
dnf install -y sqlite-devel hwloc-devel
dnf install -y libjwt-devel   # BuildRequires of Slurm >= 24.11 (EPEL9)

## ------------------------------------------------------------------- Slurm
# Client-side build, same recipe proven in the plasma image: plain
# configure/make install from the official tarball.
# Default version is the cluster's (slurm 26.05.4); a client that does not
# match the cluster's slurmctld refuses to talk to it (protocol mismatch),
# so other clusters override at build time:
#   apptainer build --build-arg SLURM_VERSION=<x.yy.z> ...
VERSION="${SLURM_VERSION:-26.05.4}"
mkdir -p /opt/slurm-build && cd /opt/slurm-build
wget -nc https://download.schedmd.com/slurm/slurm-$VERSION.tar.bz2 \
  || wget -nc https://download.schedmd.com/slurm/archive/slurm-$VERSION.tar.bz2
tar xf slurm-$VERSION.tar.bz2
cd slurm-$VERSION
./configure --prefix=/usr --with-mysql_config=/usr/bin \
            --libdir=/usr/lib64 --sysconfdir=/etc/slurm
make -j"$(nproc)"
make install
cd / && rm -rf /opt/slurm-build

# Slurm user/group (same convention as the plasma image)
groupadd -r --gid=990 slurm
useradd -r -g slurm --uid=990 slurm

sbatch --version
# Hard gate: a slurm built without munge support would install fine and
# then fail at every sbatch with an auth error.  Demand the plugin.
test -f /usr/lib64/slurm/auth_munge.so \
    || { echo "FATAL: slurm built WITHOUT auth_munge"; exit 1; }

## -------------------------------------------------- OpenEvolve (pinned venv)
# THE whole point: the FULL dependency tree installed at BUILD time, once,
# loudly -- never again on a login node.  Every package OpenEvolve imports
# at runtime is listed EXPLICITLY (pip transitive resolution alone is not a
# contract): openai = LLM client, pyyaml = config, dacite = config->dataclass,
# numpy/tqdm = engine, flask = monitoring API, cloudpickle = program serialis-
# ation (required by current openevolve releases, missing from older metadata).
python3.11 -m venv /venv/controller
/venv/controller/bin/pip install --upgrade pip setuptools wheel
/venv/controller/bin/pip install \
    "openevolve==0.4.0" \
    "openai>=1.0.0" \
    "pyyaml>=6.0" \
    "numpy>=1.22.0" \
    "tqdm>=4.64.0" \
    "flask" \
    "dacite>=1.9.2" \
    "cloudpickle>=2.0.0"
# Hard gate: import exactly what tools/launch_evolution.py + openevolve need.
# A missing dependency must fail the IMAGE BUILD, not the first tmux session.
/venv/controller/bin/python -c "
from openevolve import OpenEvolve
import openai, yaml, numpy, tqdm, flask, dacite, cloudpickle
print('openevolve + full dependency tree import OK')"

## --------------------------------------------------------------- slim down
dnf clean all
rm -rf /var/cache/dnf /root/.cache/pip /tmp/*

%runscript
    exec "$@"
